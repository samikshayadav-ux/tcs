# AutoRisk AI - Backend Environment Configuration Example
# Copy this file to .env and populate with your own keys. Do NOT commit .env.

# Server settings
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Paths to ML model artifacts and dataset
MODEL_DIR=models
DATA_PATH=data/fraud_oracle.csv

# File upload limits (default: 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# External Vision & LLM API Credentials (Optional)
# If left empty, prediction and deterministic templating work normally.
# Configure GEMINI_API_KEY or OPENAI_API_KEY to enable document image extraction.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Provider selection ('auto', 'gemini', or 'openai')
VISION_PROVIDER=auto
LLM_PROVIDER=auto

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30.0
